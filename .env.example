# Nani Cab - Supabase Environment Variables
# Copy this file to .env locally or set these in Vercel Project Settings -> Environment Variables

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-actual-anon-key-here

# Google Maps JavaScript API Key (Maps, Places, Directions)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

